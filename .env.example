# --- Database (Supabase Postgres) ---
# Pooled connection (via Supabase's connection pooler / pgbouncer) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection — used by Prisma Migrate for schema migrations.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Supabase project ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only. Bypasses RLS — never expose to the client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Google OAuth ---
# Only needed here if you manage the OAuth client outside of Supabase's built-in
# Google provider config (Auth > Providers > Google in the Supabase dashboard).
# Supabase itself only needs the Client ID/Secret entered in its dashboard, not as
# app env vars — these are provided for reference / for any server-side use.
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
